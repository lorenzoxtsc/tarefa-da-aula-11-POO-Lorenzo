using UnityEngine;

public class Player : MonoBehaviour
{
    private Arma armaAtual;
    
    void Start()
    {
        TestarArmas();
    }
    
    void Update()
    {
        // Teste com teclas
        if (Input.GetKeyDown(KeyCode.1))
        {
            EquiparEspada();
        }
        if (Input.GetKeyDown(KeyCode.2))
        {
            EquiparRevolver();
        }
        if (Input.GetKeyDown(KeyCode.Space) && armaAtual != null)
        {
            UsarArma();
        }
    }
    
    void TestarArmas()
    {
        Debug.Log("=== TESTANDO ARMAS ===");
        
        // Teste com Espada
        EquiparEspada();
        UsarArma();
        
        // Teste com Revolver
        EquiparRevolver();
        UsarArma();
        
        Debug.Log("=== FIM DOS TESTES ===");
    }
    
    void EquiparEspada()
    {
        GameObject espadaObj = new GameObject("Espada");
        Espada espada = espadaObj.AddComponent<Espada>();
        espada.Nome = "Espada Longa";
        espada.Dano = 25;
        
        armaAtual = espada;
        Debug.Log($"Equipado: {armaAtual.Nome}");
    }
    
    void EquiparRevolver()
    {
        GameObject revolverObj = new GameObject("Revolver");
        Revolver revolver = revolverObj.AddComponent<Revolver>();
        revolver.Nome = "Revolver .45";
        revolver.Dano = 40;
        
        armaAtual = revolver;
        Debug.Log($"Equipado: {armaAtual.Nome}");
    }
    
    void UsarArma()
    {
        if (armaAtual != null)
        {
            armaAtual.Usar();
        }
    }
}
